APP_NAME="متجر ديوان الأصالة"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=Asia/Aden
APP_URL=http://localhost:8000
APP_LOCALE=ar

LOG_CHANNEL=stack
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=diwan_alasala
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=file
SESSION_LIFETIME=120
CACHE_STORE=file
QUEUE_CONNECTION=sync
FILESYSTEM_DISK=public

SANCTUM_STATEFUL_DOMAINS=localhost:8000

# بيانات دخول المدير الأول (تُستخدم فقط عند تشغيل: php artisan db:seed --class=AdminUserSeeder)
ADMIN_NAME="مدير المتجر"
ADMIN_EMAIL=admin@diwan-alasala.ye
ADMIN_PASSWORD=CHANGE_ME_ON_FIRST_LOGIN

# رقم واتساب المتجر (بصيغة دولية بدون + أو 00)
WHATSAPP_NUMBER=967700000000

# البريد الإلكتروني لإشعارات الطلبات الجديدة
STORE_OWNER_EMAIL=owner@diwan-alasala.ye

# جيب JIB
JIB_ACCOUNT_NAME=
JIB_ACCOUNT_NUMBER=

# كريمي Kareemi
KAREEMI_ACCOUNT_NAME=
KAREEMI_ACCOUNT_NUMBER=

FACEBOOK_URL=
INSTAGRAM_URL=

STORE_NAME="متجر ديوان الأصالة"
STORE_CURRENCY="ريال يمني"
SHIPPING_COST_SANAA=1500

# ---------- البريد (لإشعارات الطلبات الجديدة) ----------
MAIL_MAILER=log
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="no-reply@diwan-alasala.ye"
MAIL_FROM_NAME="${APP_NAME}"

# ---------- الأمان ----------
# مدة صلاحية رمز دخول لوحة التحكم بالدقائق (10080 = 7 أيام، 0 = بدون انتهاء — غير مستحسن)
SANCTUM_EXPIRATION=10080
# النطاق المسموح له باستدعاء الـ API من متصفح آخر (افتراضيًا APP_URL)
FRONTEND_URL=
# في الإنتاج (HTTPS): اجعلها true، واجعل APP_ENV=production و APP_DEBUG=false
SESSION_SECURE_COOKIE=false

# ---------- إشعار الطلبات الجديدة عبر Telegram (للجوال والكمبيوتر) ----------
# 1) أنشئ بوت من @BotFather وضع التوكن هنا  2) أرسل أي رسالة للبوت  3) ضع رقم المحادثة (chat id)
# لأكثر من شخص: افصل بين الأرقام بفاصلة
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ---------- تخزين الملفات المرفوعة (صور المنتجات والإيصالات) ----------
# محليًا: public و local (ملفات على الجهاز — شغّل php artisan storage:link مرة واحدة)
# Laravel Cloud Starter: db_public و db_private (داخل قاعدة البيانات — ملفات السيرفر هناك تُمسح مع كل نشر)
# لاحقًا مع Object Storage أو S3: اسم قرص الـ Bucket — بدون أي تعديل في الكود
PRODUCT_IMAGES_DISK=public
RECEIPTS_DISK=local
